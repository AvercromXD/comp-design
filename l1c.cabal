cabal-version:      3.0
name:               l1c
version:            0.1.0.0

synopsis: Simple toy compiler
description: This was developed for the lecture 'Compiler Design' in the summer term 2025 by André Platzer at KIT Karlsruhe

author:             Darius Schefer, Ian Schmettkamp, Peter Achinger
maintainer:         darius.schefer@student.kit.edu

build-type:         Simple
license:            MIT

common warnings
    ghc-options: -Wall

library  
    import:           warnings
    exposed-modules:
                  Args,
                  Compile,
                  Compile.AST,
                  Compile.Parser,
                  Compile.Semantic,
                  Compile.InstructionSelection,
                  Compile.AAAST,
                  Compile.Liveness,
                  Compile.GraphColoring,
                  Compile.RegisterAllocation,
                  Error
    build-depends:
                  base >= 4.15 && < 5,
                  containers,
                  unordered-containers,
                  heap,
                  directory,
                  filepath,
                  megaparsec >= 9.7.0,
                  mtl,
                  optparse-applicative >= 0.18.1.0,
                  parser-combinators,
                  transformers
    hs-source-dirs:   src
    default-language: Haskell2010

executable l1c-exec
    import:           warnings
    main-is:          Main.hs
    build-depends:
                  base >= 4.15 && < 5,
                  l1c,
                  mtl,
                  optparse-applicative
    hs-source-dirs:   app
    default-language: Haskell2010

test-suite l1c-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    build-depends:
                  base >= 4.15 && < 5,
                  hspec,
                  hspec-discover,
                  l1c,
                  containers,
                  unordered-containers,
    hs-source-dirs:   test
    default-language: Haskell2010